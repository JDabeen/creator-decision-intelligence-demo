YOUTUBE_API_KEY=
OPENAI_API_KEY=

# 선택: 비워두면 앱 설정의 기본값(바탕화면\youtube_consultant_data)을 사용합니다.
# YRA_DATA_DIR=C:/Users/USERNAME/Desktop/youtube_consultant_data

# Draft B Critic Agent (optional)
# 비우면 앱의 LLM 모델을 그대로 사용합니다. 더 강한 모델을 쓰려면 예: gpt-6.1-sol
YRA_CRITIC_MODEL=
# 1=필요하면 웹 검색 허용, 0=내부 Research만 사용
YRA_CRITIC_WEB_SEARCH=1

# 선택: 무료 Supadata 자막 예비 경로. 앱의 Research Coverage 복구창에서도 등록 가능.
# 외부 API는 시장 경쟁 영상 자막에만 사용하며, 기본 mode=native (유료 AI 음성인식 비활성화)
# SUPADATA_API_KEY=

# 선택: Hermes 웹 검색·추출 백엔드. 제공자 이용 조건 및 비용 확인.
# SUPADATA_API_KEY와는 목적이 다릅니다.
# TAVILY_API_KEY=
# EXA_API_KEY=
# 필요하면 Hermes 호출 제한 시간 조정(초). 기본 240초.
# YRA_HERMES_TIMEOUT=300

# Hermes 인터넷 조사 옵션 (기본 1 = Docker 내부 전용 Chromium 허용)
# Windows Chrome, 로그인 쿠키, 문서/사진 폴더는 연결하지 않습니다.
# 브라우저 도구는 전체 toolset이므로 공개 페이지 읽기 외 동작에 주의.
# YRA_HERMES_BROWSER=1
# 브라우저를 끄고 web_search/web_extract만 사용하려면 0
# YRA_HERMES_BROWSER=0

# 자동 전략 기록은 기본적으로 Windows 바탕화면\YT_Channel_Strategy 에 저장됩니다.
# OneDrive 바탕화면 전환도 지원. 다른 폴더를 원할 때만 아래 경로 지정:
# YRA_STRATEGY_DIR=C:/Users/USERNAME/Desktop/YT_Channel_Strategy

# 선택: SerpApi (제3자 Google Trends 상대 관심도 API, 비용/약관 확인)
# 있으면 새 주제 찾기 때 한국 YouTube 검색 관심도를 추가 자동 수집합니다.
# 없으면 호출·추가 과금 없이 기존 YouTube 경쟁 영상 지표만 사용합니다.
# SERPAPI_API_KEY=
